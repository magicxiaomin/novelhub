{
  "name": "@novelhub/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "rm -f public/sw.js public/sw.js.map public/workbox-*.js public/workbox-*.js.map",
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @novelhub/shared build && next build",
    "start": "next start -p 3000",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pages:build": "BUILD_TARGET=pages NEXT_PUBLIC_BUILD_TARGET=pages pnpm --filter @novelhub/shared build && BUILD_TARGET=pages NEXT_PUBLIC_BUILD_TARGET=pages next-on-pages",
    "pages:deploy": "wrangler pages deploy .vercel/output/static --project-name novelhub-web",
    "pages:dev": "wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat --port=8788"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@novelhub/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.2",
    "@sentry/nextjs": "^10.52.0",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "^14.2.26",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "autoprefixer": "^10.4.21",
    "eslint-config-next": "^14.2.26",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "wrangler": "^3.78.0"
  }
}
