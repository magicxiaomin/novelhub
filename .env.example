# =============================================================================
# NovelHub Environment Variables
#
# Copy this file to `.env` for local development. Never commit a real `.env`.
#
# Production note: do NOT copy these placeholders into Vercel env stores —
# every value here is either a `local-dev` default or an empty placeholder.
# Set production values per `docs/runbook.md`.
#
# Variables prefixed `NEXT_PUBLIC_` are exposed to the browser bundle —
# never put secrets there.
#
# Where each variable belongs (Phase 1 launch — Vercel-only, no Railway):
#   [VW]  = Vercel Production - novelhub-web project
#   [VA]  = Vercel Production - novelhub-api project
#   [BOTH] = both Vercel projects (web + api)
#   [L]   = local development only
# =============================================================================

# ----- Database / cache -------------------------------------------------- [VA]
# Phase 1: Supabase Postgres connection string with pgbouncer pool mode.
# Recommended URI shape: postgresql://USER:PASS@HOST:6543/DB?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://user:password@localhost:5432/novelhub
# Phase 1: leave empty. CacheClient falls back to a no-op when unset; only
# perf optimisations are skipped (book list / chapter preview / per-email
# rate limit on /support/contact). Add Upstash in Phase 2.
REDIS_URL=

# ----- Auth (server-only) ------------------------------------------------ [VA]
# 32+ random bytes each. Different values for access and refresh secrets.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public OAuth client id (browser-visible) ----------------------------- [VW]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ----- Stripe (server-only, Live Mode in production) -------------------- [VA]
# IMPORTANT: production must use sk_live_* / whsec_* values from Stripe
# Dashboard → live mode. A sk_test_* key in production silently lets test
# cards pay you in Monopoly money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=

# ----- Storage (Cloudflare R2) ------------------------------------------- [VA]
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=novelhub-content
# Public R2 hostname used by the BACKEND when stamping cover URLs onto
# /books responses. Must match NEXT_PUBLIC_R2_PUBLIC_HOST below.
R2_PUBLIC_HOST=

# ----- Tracking (Facebook) -------------------------------------------- [BOTH]
# Pixel ID is browser-visible (loaded from <script>); CAPI access token is
# server-only.
NEXT_PUBLIC_FB_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=
# Production: leave empty. Setting a value routes events to Meta's "Test
# Events" view instead of the live aggregate.
FB_TEST_EVENT_CODE=

# ----- Email (Resend) ---------------------------------------------------- [VA]
# Phase 1: optional. Without RESEND_API_KEY, password-reset and support
# contact emails are logged but not sent.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_FROM_EMAIL=NovelHub Support <support@yourdomain.com>

# Public addresses surfaced in legal / contact pages ----------------- [VW]
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_DMCA_EMAIL=dmca@yourdomain.com

# ----- Push (OneSignal) ----------------------------------------------- [BOTH]
# Phase 1: leave both empty to disable push. Frontend push UI is gated on
# NEXT_PUBLIC_ONESIGNAL_APP_ID; backend skips OneSignal calls when keys
# are missing. Re-enable in Phase 2 once the SW scope collision verified
# in #46 is real-device tested.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ----- App URLs / domain variants ------------------------------------ [BOTH]
# Canonical web origin. Phase 3 production drama variant: https://dramavela.com
# (with https://www.dramavela.com in CORS_EXTRA_ORIGINS). Novel variant:
# https://novel.dramavela.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public API base URL for browser and RSC calls. May be absolute
# (https://api.dramavela.com) or a same-origin proxy path (/api-proxy).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Legacy name retained during cutover; leave equal to NEXT_PUBLIC_API_BASE_URL
# until all environments have switched.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side web fetch target used when NEXT_PUBLIC_API_BASE_URL/NEXT_PUBLIC_API_URL
# is a relative same-origin proxy path such as /api-proxy.
API_INTERNAL_URL=http://localhost:4000
# Comma-separated extra browser origins allowed for credentialed CORS, e.g.
# https://www.dramavela.com,https://novel.dramavela.com
CORS_EXTRA_ORIGINS=
# Optional and intentionally blank by default. Set .dramavela.com only after
# approving shared auth cookies across drama and novel subdomains; host-only
# cookies are safer for independent variants.
AUTH_COOKIE_DOMAIN=

# Public CDN / R2 hostname for cover images ---------------------------- [VW]
NEXT_PUBLIC_IMAGE_HOST=

# Public R2 hostname allowed for chapter content fetches --------------- [VW]
# Must match R2_PUBLIC_HOST so backend cover URLs and frontend SW caching
# / reader URL allowlist agree on the same Cloudflare hostname.
NEXT_PUBLIC_R2_PUBLIC_HOST=

# Local-dev only: when R2 isn't configured, the API can serve seeded
# chapter content from /static/chapters/. Set to "true" to allow the
# reader to fetch from NEXT_PUBLIC_API_URL's host. PRODUCTION MUST LEAVE
# THIS UNSET — it bypasses the R2-only allowlist that prevents SSRF /
# proxy abuse via the chapter-content fetch path.
NEXT_PUBLIC_DEV_ALLOW_API_CONTENT=

NODE_ENV=development

# ----- Monitoring (Sentry) -------------------------------------------- [BOTH]
# DSNs are environment-specific (one per project). Keep web and api on
# separate Sentry projects so source maps and quotas don't tangle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source-map upload during Vercel builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_API=

# ----- Cron (Phase 1 — Vercel Cron) ---------------------------------- [VA]
# Set CRON_DRIVER=vercel in the Vercel API project to disable the in-process
# @nestjs/schedule scheduler. Vercel Cron Jobs become the source of truth;
# they hit /api/cron/re-engagement and /api/cron/renewal-reminders per the
# schedule in apps/api/vercel.json. Leave unset locally so the in-process
# scheduler keeps working in dev.
CRON_DRIVER=
# Shared-secret bearer token Vercel Cron sends in the Authorization header.
# Generate a 32+ char random string. If unset, the cron endpoints accept
# unauthenticated requests — fine for local dev, NOT acceptable in prod.
CRON_SECRET=
