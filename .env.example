# =============================================================================
# NovelHub Environment Variables
# Copy this file to .env and fill in actual values
# Never commit .env to version control
# =============================================================================

# ----- Database -----
DATABASE_URL=postgresql://user:password@localhost:5432/novelhub
REDIS_URL=redis://localhost:6379

# ----- Auth -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...

# ----- Storage (Cloudflare R2) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=novelhub-content

# ----- Tracking (Facebook) -----
NEXT_PUBLIC_FB_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=
FB_TEST_EVENT_CODE=TEST00000

# ----- Email (Resend) -----
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_FROM_EMAIL=NovelHub Support <support@yourdomain.com>
NEXT_PUBLIC_SUPPORT_EMAIL=support@novelhub.com
NEXT_PUBLIC_DMCA_EMAIL=dmca@yourdomain.com
# Public R2 hostname used by backend to derive cover URLs (separate from
# NEXT_PUBLIC_R2_PUBLIC_HOST so backend has its own knob).
R2_PUBLIC_HOST=cdn.novelhub.local

# ----- Push (OneSignal) -----
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public CDN/R2 hostname for cover images.
NEXT_PUBLIC_IMAGE_HOST=
# Public R2 hostname allowed for chapter content fetches.
NEXT_PUBLIC_R2_PUBLIC_HOST=cdn.novelhub.local
# Local-dev only: when R2 isn't configured, the API can serve chapter
# content from /static/chapters/ for the seeded classics. Set to "true"
# to allow the reader to fetch from NEXT_PUBLIC_API_URL's host. Production
# MUST leave this unset (or "false") — it bypasses the R2-only allowlist
# that prevents SSRF/proxy abuse via the chapter-content fetch path.
NEXT_PUBLIC_DEV_ALLOW_API_CONTENT=
NODE_ENV=development

# ----- Monitoring -----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_API=
