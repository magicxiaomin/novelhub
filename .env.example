# =============================================================================
# NovelHub Environment Variables
# Copy this file to .env and fill in actual values
# Never commit .env to version control
# =============================================================================

# ----- Database -----
DATABASE_URL=postgresql://user:password@localhost:5432/novelhub
REDIS_URL=redis://localhost:6379

# ----- Auth -----
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_MONTHLY=price_...

# ----- Storage (Cloudflare R2) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=novelhub-content

# ----- Tracking (Facebook) -----
NEXT_PUBLIC_FB_PIXEL_ID=
FB_CAPI_ACCESS_TOKEN=
FB_TEST_EVENT_CODE=TEST00000

# ----- Email (Resend) -----
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ----- Push (OneSignal) -----
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development

# ----- Monitoring -----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
