# Build output
**/dist
**/.next
**/node_modules

# Local-dev only assets — apps/api/static/chapters is gated behind
# NODE_ENV !== 'production' in src/main.ts, so prod images don't need
# the ~750KB of seeded Project Gutenberg text.
apps/api/static

# Non-source artifacts that bloat the build context
.git
.github
docs
*.md
!packages/db/prisma/migrations/**/*.md
.claude
.vscode
.idea
.husky

# Local env / personal config (Vercel/Railway pulls env from their UIs)
.env
.env.local
.env.*.local

# Tests / fixtures (production image doesn't need them)
**/*.spec.ts
**/__tests__
**/coverage

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
