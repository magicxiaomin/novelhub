{
  "name": "@novelhub/db",
  "version": "0.1.0",
  "private": true,
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "lint": "node scripts/validate-prisma.mjs",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate-deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.mjs",
    "seed:staging:suspense-1913": "node prisma/staging-suspense-1913.seed.mjs",
    "seed:production:suspense-1913": "node prisma/production-suspense-1913.seed.mjs",
    "test:staging:suspense-1913": "node --test prisma/staging-suspense-1913.seed.test.mjs",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "typecheck": "node scripts/validate-prisma.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "prisma": "^6.6.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
